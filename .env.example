# 复制此文件为 .env 并填入你的聚宽账号（.env 不会被提交到 Git）
JOINQUANT_USERNAME=你的手机号
JOINQUANT_PASSWORD=你的密码

# 聚宽上要打开并覆盖的策略名称（换策略时改此项）
# JOINQUANT_STRATEGY_NAME=自动化测试用

# 阶段 3：本地策略文件（真相源，上传至聚宽）
# AUTORESEARCH_STRATEGY_FILE=strategies/ETF动量.py
# AUTORESEARCH_MAX_AGENT_ROUNDS=10
# AUTORESEARCH_AGENT_RETRIES=2
# playwright练习.py：SAVE_BACKTEST_ARTIFACTS / CONFIGURE_BACKTEST_PANEL 默认 False 可改 True
# 阶段 3.3：回测后自动生成 result/<run_id>/agent_task.md；或 python build_agent_task.py result/<run_id>
# 阶段 3.2 一键：python research_start.py
# 阶段 3.1 仅回测：python research_run.py [--session experiments/sessions/.../session.json]

# 可选：回测参数（也可直接在 backtest_config.py 中修改）
# JOINQUANT_BACKTEST_START_DATE=2026-02-01
# JOINQUANT_BACKTEST_END_DATE=2026-08-01
# JOINQUANT_BACKTEST_INITIAL_CAPITAL=100000
# JOINQUANT_BACKTEST_FREQUENCY=每天

# autoresearch 阶段 1：达标目标（写入 run_manifest.json）
# AUTORESEARCH_GOAL_ANNUAL_RETURN_MIN=30
# AUTORESEARCH_GOAL_MAX_DRAWDOWN_MAX=10

# 阶段 2 orchestrator（只调策略参数，不改回测区间/资金）
# 阶段 2：python orchestrator.py [--pipeline-only] [--max-trials N]
# AUTORESEARCH_MAX_TRIALS=5
# AUTORESEARCH_STOP_ON_PASS=true
# AUTORESEARCH_PATIENCE=0
